GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Voice input for the Assistant (AssemblyAI Dictation). Optional — without a
# key the Dictate button is hidden. https://www.assemblyai.com/docs/dictation
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# DICTATION_LANGUAGES=en

# Where captures, the SQLite database, and the memory graph live
# SINGULARITY_DATA_DIR=~/.singularity
# SINGULARITY_PORT=3030

# Optional app connections through Composio
# COMPOSIO_API_KEY=your_composio_api_key_here
